// Copy to Config/Local.xcconfig (gitignored) and fill in your team ID.
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// Optional: a temporary live-preview server for the humancodereader seed bot
// (for example a dev server behind `tailscale serve`). xcconfig treats "//"
// as a comment, so write the scheme as http:/$()/ .
// MUXBOT_TEST_PREVIEW_URL = http:/$()/your-mac.your-tailnet.ts.net:8445/
// Optional: the darkmux work folder for that bot (must be under ~/.darkmux/worktrees).
// MUXBOT_TEST_WORKDIR = ~/.darkmux/worktrees/hcr-preview
